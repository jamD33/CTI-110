#Using Turtle graphics 

import turtle 

# Create the turtle window and drawing object
screen = turtle.Screen()
screen.bgcolor("skyblue")     # Changed background color

# Set up turtle options
t = turtle.Turtle()
t.color("dark green")
t.pensize(3)
t.speed(3)

# Draw the Square base using a FOR loop
for _ in range(4) :
    t.forward(100)
    t.left(90)

# Move the turtle to the top-left corner of the square to start the roof 
# The square was drawn counter-clockwise, so the turtle is back at the bottom-left, facing Right.
t.left(90)
t.forward(100)
t.right(90)
# Now the turtle is at the top-left corner facing Right.

# --- 2. Draw the Triangle (Roof) using a WHILE loop ---
# An equilateral triangle requires three 120-degree exterior turns
side_count = 0 
while side_count < 3:
    t.forward(100)
    t.left(120)
    side_count += 1
# Hide the turtle and keep the window open
t.hideturtle()
turtle.done()